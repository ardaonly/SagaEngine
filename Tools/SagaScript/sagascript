#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repository_root="$(cd "$script_dir/../.." && pwd)"
engine_version="$(tr -d '[:space:]' < "$repository_root/VERSION")"
stage_root="${SAGA_MANAGED_TOOL_STAGE:-$repository_root/build/RelWithDebInfo-$engine_version/ManagedToolRuntime}"
private_host="$stage_root/runtime/dotnet/dotnet"
tool_dll="$stage_root/tools/SagaScript/sagascript.dll"

if [[ ! -x "$private_host" || ! -f "$tool_dll" ]]; then
    printf 'sagascript: private managed tool stage is missing; build SagaManagedToolRuntimeStage\n' >&2
    exit 127
fi

export DOTNET_ROOT="$stage_root/runtime/dotnet"
export DOTNET_ROOT_X64="$DOTNET_ROOT"
export DOTNET_HOST_PATH="$private_host"
export DOTNET_MULTILEVEL_LOOKUP=0
export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
exec "$private_host" "$tool_dll" "$@"
