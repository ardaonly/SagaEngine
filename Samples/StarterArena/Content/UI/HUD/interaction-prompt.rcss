/* SPDX-License-Identifier: MIT */
@font-face {
  font-family: DejaVu Sans;
  src: url(../ThirdParty/DejaVu/DejaVuSans.ttf);
}

body {
  width: 100%;
  height: 100%;
  font-family: DejaVu Sans;
  pointer-events: none;
  margin: 0;
}

.prompt-anchor {
  position: absolute;
  left: 0;
  width: 100%;
  bottom: 8%;
  text-align: center;
}

.interaction-prompt {
  display: inline-block;
  padding: 12px 18px;
  color: #ffffff;
  background-color: rgba(12, 18, 28, 210);
  border: 1px #78b8ff;
  border-radius: 5px;
  font-size: 24px;
}
