<rml>
<head>
  <title>Starter Arena HUD</title>
  <style>
    body {
      width: 100%;
      height: 100%;
      font-family: DejaVu Sans;
      pointer-events: none;
      margin: 0;
    }
    .prompt-anchor {
      position: absolute;
      left: 0;
      width: 100%;
      bottom: 8%;
      text-align: center;
    }
    .interaction-prompt {
      display: inline-block;
      padding: 12px 18px;
      color: #ffffff;
      background-color: rgba(12, 18, 28, 210);
      border: 1px #78b8ff;
      border-radius: 5px;
      font-size: 24px;
    }
  </style>
</head>
<body>
  <div class="prompt-anchor">
    <div id="interaction-prompt" class="interaction-prompt">[E] Open Door</div>
  </div>
</body>
</rml>
