@font-face { font-family: DejaVu Sans; src: url(../ThirdParty/DejaVu/DejaVuSans.ttf); }
body { width: 100%; height: 100%; margin: 0; font-family: DejaVu Sans; color: #eefcff; background-color: rgba(3, 10, 20, 225); pointer-events: none; }
.results-card { width: 58%; margin: 16% auto; padding: 32px; text-align: center; background-color: #0b2235; border: 2px #72cfff; }
h1 { color: #63ffe0; font-size: 44px; }
.result-value { color: #8fc8ff; font-size: 30px; }
.results-card div { display: inline-block; margin: 12px; padding: 10px 16px; background-color: #173c55; }
