<rml>
<head>
  <title>Arena Rush Results</title>
  <link type="text/rcss" href="results.rcss"/>
</head>
<body>
  <div class="results-card">
    <h1 id="result-title"></h1>
    <p class="result-value">Energy collected: <span id="result-score"></span> / <span id="result-target"></span></p>
    <div id="results-restart-key"></div>
    <div id="results-exit-key"></div>
  </div>
</body>
</rml>
