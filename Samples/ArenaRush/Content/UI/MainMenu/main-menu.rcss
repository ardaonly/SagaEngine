@font-face { font-family: DejaVu Sans; src: url(../ThirdParty/DejaVu/DejaVuSans.ttf); }
body {
  width: 100%;
  height: 100%;
  margin: 0;
  font-family: DejaVu Sans;
  color: #eefcff;
  background-color: rgba(3, 10, 20, 220);
  pointer-events: none;
}
.menu-card { width: 62%; margin: 12% auto; padding: 36px; text-align: center; background-color: #0b2235; border: 2px #3ff0d0; }
h1 { font-size: 54px; color: #63ffe0; margin: 0; }
h2 { font-size: 28px; color: #8fc8ff; }
.key-line { display: inline-block; margin: 10px; padding: 12px 18px; background-color: #173c55; border: 1px #72cfff; }
.foundation-note { color: #91a9b8; font-size: 16px; }
