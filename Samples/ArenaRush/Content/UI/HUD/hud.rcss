@font-face { font-family: DejaVu Sans; src: url(../ThirdParty/DejaVu/DejaVuSans.ttf); }
body { width: 100%; height: 100%; margin: 0; font-family: DejaVu Sans; color: #ffffff; pointer-events: none; }
.hud-top { position: absolute; top: 4%; left: 5%; right: 5%; text-align: center; }
.stat { display: inline-block; margin: 0 24px; padding: 10px 20px; font-size: 30px; background-color: rgba(4, 19, 32, 220); border: 1px #3ff0d0; }
.label { margin-right: 12px; color: #72cfff; font-size: 16px; }
.hud-bottom { position: absolute; bottom: 5%; left: 0; width: 100%; text-align: center; color: #bfffee; }
.hud-bottom div { display: inline-block; margin: 0 10px; padding: 8px 14px; background-color: rgba(4, 19, 32, 220); }
